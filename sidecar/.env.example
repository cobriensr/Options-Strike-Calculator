# Sidecar local-dev template. Copy to .env (gitignored), fill in what you need,
# then export it before running (see README "Local development"). Production
# values live in Railway, not here.

# Required. Neon connection, used only by the /health DB check. Keep the quotes.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Runtime
PORT=8080

# Error tracking. Empty disables Sentry.
SENTRY_DSN=

# Take-It SHAP server (POST /takeit/explain). 1 enables it; it also needs the
# shared secret and the Blob token.
TAKEIT_SERVER_ENABLED=0
TAKEIT_SIDECAR_SHARED_SECRET=
# TAKEIT_MAX_BODY_BYTES=1048576

# Vercel Blob read token: Take-It model bundles and the archive seeder.
BLOB_READ_WRITE_TOKEN=

# Frozen archive. Seeding needs ARCHIVE_MANIFEST_URL, BLOB_READ_WRITE_TOKEN and
# ARCHIVE_SEED_TOKEN. Leave the optional lines commented to keep the defaults.
ARCHIVE_MANIFEST_URL=
ARCHIVE_SEED_TOKEN=
# ARCHIVE_ROOT=/data/archive
# ARCHIVE_QUERY_CONCURRENCY=2
# ARCHIVE_BLOB_ALLOWED_HOSTS=
