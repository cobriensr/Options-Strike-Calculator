# ============================================================
# Strike Calculator — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# In production, Vercel auto-injects these from the dashboard
# (Settings → Environment Variables) and from Marketplace
# integrations (Neon, Upstash, Sentry, Blob).
#
# api/_lib/env.ts validates the core server vars with Zod (database,
# Redis, auth, the Anthropic/OpenAI/UW/GEXBot/FRED/Finnhub keys,
# Twilio, observability, classifier, APP_URL). Some optional
# integrations read process.env directly.
# A new var goes in code, env.ts, this file and the CLAUDE.md table
# in the same commit.

# ── Authentication ──────────────────────────────────────────
# Single-owner secret. Set to a long random string
# (e.g. openssl rand -hex 32). The OAuth callback sets the
# httpOnly sc-owner cookie to this value; it gates every write.
OWNER_SECRET=

# Comma-separated guest read keys (optional). A guest enters one
# in the access-key form, which sets a 30-day sc-guest cookie.
# Guests can read data endpoints (dark pool, GEX, TRACE Live,
# etc.) and save their own panel layout, never call the
# Anthropic-backed analyze endpoint.
GUEST_ACCESS_KEYS=

# ── Schwab Market Data API ──────────────────────────────────
# Required for live quotes, intraday data, and options chain.
# Register at https://developer.schwab.com
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
# Lowercase hex sha256 of the owner's plain Schwab accountNumber, as
# GET /trader/v1/accounts/accountNumbers returns it (NOT its hashValue).
# The OAuth callback stores a login's tokens only if that login owns this
# account. Unset → every login is refused (500), nothing stored.
# Compute locally: printf '%s' '<accountNumber>' | sha256sum
# Refused login? Retry from /api/auth/init: the refused callback spent its
# OAuth state. Keep the owner account selected on Schwab's consent screen,
# or the login is refused. Preview deploys refuse Schwab login unless this
# is set for Preview; expected, since previews use guest keys.
OWNER_SCHWAB_ACCOUNT_SHA256=

# ── App URL ───────────────────────────────────────────────
# Public origin of this app. Builds the OAuth redirect URI
# (<APP_URL>/api/auth/callback) and other absolute URLs.
# Local dev: http://localhost:3000
APP_URL=

# ── Database (Neon Postgres) ────────────────────────────────
# Auto-created when you add Neon from the Vercel Marketplace.
# DATABASE_URL is read by the Vercel Functions (@neondatabase/
# serverless, HTTP driver) and by the Railway services. The
# unpooled URL is used only by backfill and probe scripts in
# scripts/ that hold long connections.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Cache / Token Store (Upstash Redis) ─────────────────────
# Auto-created when you add Upstash from the Vercel Marketplace.
# Either pair works — api/_lib/env.ts accepts KV_* or UPSTASH_*.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── AI Chart Analysis (Anthropic) ──────────────────────────
# Required for Chart Analysis (Claude Opus, Sonnet fallback),
# lesson curation and ML plot analysis.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# ── AI Embeddings (OpenAI) ────────────────────────────────
# Required for lessons-learned dedup and analog-day retrieval
# (text-embedding-3-large).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Which similarity engine finds historical analog days for the
# analyze context: 'features' (engineered path-shape vectors) or
# unset / anything else (OpenAI text embeddings, the default).
DAY_ANALOG_BACKEND=

# ── Market Data (Unusual Whales) ──────────────────────────
# Required for flow, Greek exposure, dark pool levels and the
# uw-stream Railway service (Advanced tier for websocket access).
UW_API_KEY=

# Optional override of the UW per-minute request guard
# (api/_lib/uw-rate-limit.ts). Default 2000; digits only.
UW_PER_MINUTE_CAP=

# ── Market Data (GEXBot) ──────────────────────────────────
# Dealer gamma/charm/vanna state for the Periscope, GEX Landscape,
# GEXBot and Periscope Lottery panels (empty without it).
GEXBOT_API_KEY=

# ── Cron Jobs ────────────────────────────────────────────
# Auto-provided by Vercel in production for cron auth. Crons
# accept GET with Authorization: Bearer <CRON_SECRET>.
# Set a random string for local testing.
CRON_SECRET=

# ── Internal Webhooks ─────────────────────────────────────
# Gates /api/push/notify. uw-stream sends it as a bearer token when
# it pushes Interval B/A alerts. Set the same value on Railway.
INTERNAL_NOTIFY_SECRET=

# ── Periscope scripts (scripts/ only) ─────────────────────
# Read only by the Periscope backfill and probe scripts in
# scripts/ (backfill-periscope-playbook.mjs, periscope-*-probe.mjs).
# No Vercel function reads them.
PERISCOPE_URL=
PERISCOPE_WEBHOOK_SECRET=

# ── Vercel Blob ────────────────────────────────────────────
# ML plots, the Take-It model bundle, archives and DB backups.
# Auto-provided when Blob is added from the Vercel Marketplace.
BLOB_READ_WRITE_TOKEN=

# ── Railway sidecar ───────────────────────────────────────
# Public URL of the sidecar/ Railway service. api/ calls its
# read-only /archive/* routes (analog days, fetch-day-ohlc).
SIDECAR_URL=

# Take-It SHAP: the takeit-fill-shap cron posts scored Lottery
# Finder fires to the sidecar's /takeit/explain for SHAP flags.
# The Take-It score itself is computed in TypeScript
# (api/_lib/takeit-score.ts). SIDECAR_TAKEIT_SECRET must equal the
# sidecar's TAKEIT_SIDECAR_SHARED_SECRET.
SIDECAR_TAKEIT_URL=
SIDECAR_TAKEIT_SECRET=

# ── Multileg Classifier (Railway) ─────────────────────────
# Public URL of the classifier/ Railway service. The detect crons
# POST trades to /multileg-classify for multileg structure labels.
# Unset → NULL multileg columns + Sentry multileg.classify.config_missing.
# Retirement approved 2026-10-28; see
# docs/superpowers/specs/2026-10-28-classifier-replacement-design.md.
CLASSIFIER_URL=
# Bearer token the classifier requires on /multileg-classify and
# /version. Set the same value on Vercel and on the Railway
# classifier service. Unset → same config_missing behavior as above.
CLASSIFIER_SHARED_SECRET=

# ── Web Push (PWA notifications) ──────────────────────────
# Optional. Required only if you want browser push alerts.
# Generate with: npx web-push generate-vapid-keys
# VAPID_SUBJECT is a mailto: URL or HTTPS origin you control.
# VITE_VAPID_PUBLIC_KEY is the same public key, exposed to the
# frontend build; push stays off when it is unset.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
VITE_VAPID_PUBLIC_KEY=

# ── Error Tracking (Sentry) ────────────────────────────────
# Auto-created when you add Sentry from the Vercel Marketplace.
# SENTRY_DSN is the server DSN; VITE_SENTRY_DSN is the frontend
# DSN baked in at build time. SENTRY_AUTH_TOKEN, SENTRY_ORG and
# SENTRY_PROJECT upload source maps at build.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Logging ────────────────────────────────────────────────
# pino log level: trace | debug | info | warn | error | fatal
# Default: info
LOG_LEVEL=

# Optional Axiom dataset + key for per-cron-run events
# (api/_lib/axiom.ts reportCronRun).
AXIOM_DATASET=
AXIOM_API_KEY=

# ── SMS Alerts (Twilio) ──────────────────────────────────
# Optional. The monitor-flow-ratio cron texts 0DTE put/call
# flow-ratio surges. All four must be set for SMS to send
# (see api/_lib/env.ts requireEnvGroup('twilio')).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_FROM=
# ALERT_PHONE_TO=

# ── Optional: Event Calendar ──────────────────────────────
# /api/events: FRED for economic releases (CPI, NFP, GDP, PCE,
# PPI, retail sales, JOLTS), Finnhub for mega-cap earnings.
FRED_API_KEY=
FINNHUB_API_KEY=

# ── Local dev only ─────────────────────────────────────────
# Where `npm run dev` (Vite) proxies /api/*. Default
# http://localhost:3000 (vercel dev).
# VITE_API_TARGET=

# ── Vercel Runtime (auto-injected — do NOT set locally) ────
# Documented here for reference. The platform sets these in
# production / preview / development environments.
# VERCEL=1
# VERCEL_ENV=production | preview | development
# NODE_ENV=production | development | test

# ── Railway-only services (NOT used by Vercel functions) ───
# These belong in the Railway dashboard for each service, not in
# this file. Listed here as a reminder for whoever provisions
# Railway (each service's README has the full table):
#
#   sidecar:    DATABASE_URL (only for its /health db check),
#               SENTRY_DSN, TAKEIT_SIDECAR_SHARED_SECRET,
#               ARCHIVE_MANIFEST_URL, ARCHIVE_SEED_TOKEN,
#               ARCHIVE_ROOT, BLOB_READ_WRITE_TOKEN,
#               RAILWAY_RUN_UID
#   uw-stream:  UW_API_KEY, DATABASE_URL, SENTRY_DSN, WS_CHANNELS,
#               KV_REST_API_URL, KV_REST_API_TOKEN (connection
#               lease), VERCEL_NOTIFY_URL, INTERNAL_NOTIFY_SECRET
#   classifier: CLASSIFIER_SHARED_SECRET, SENTRY_DSN
