    "scripts/_lib/strike-all-backfill.test.ts",
    "scripts/backfill-market-internals.ts",
    "scripts/_lib/market-internals-backfill.ts",
    "scripts/_lib/market-internals-backfill.test.ts",
    "scripts/_lib/market-internals-backfill-cli.test.ts",
