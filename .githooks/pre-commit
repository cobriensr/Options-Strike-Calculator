#!/bin/sh
# Claude Code commit gates. Claude Code sets CLAUDECODE=1 in its tool shells;
# every other commit passes untouched.
#  1. Spec review: blocks a commit that adds a spec or plan under
#     docs/superpowers/ with no spec-reviewer run or owner waiver on record
#     (scripts/spec-review-check.mjs). A commit that replays existing commits
#     (merge, cherry-pick, revert, rebase) skips it: it would list docs that
#     other sessions added. Spec: docs/superpowers/specs/2026-11-21-spec-review-gate-design.md
#  2. Review gate: blocks a commit whose staged content the last passing
#     `npm run review` in this worktree didn't see. Spec: docs/superpowers/specs/commit-gate-2026-10-28.md
# Enable once per clone: git config core.hooksPath .githooks
[ "$CLAUDECODE" = "1" ] || exit 0

# Lower case on purpose: git exports GIT_DIR to a hook in a linked worktree,
# and a shell variable of that name would reach every git call below.
gitdir=$(git rev-parse --git-dir) || exit 1
replaying=
for marker in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
  if [ -e "$gitdir/$marker" ]; then replaying=1; fi
done
if [ -z "$replaying" ]; then
  # --no-renames: git would report a doc renamed inside specs/ or plans/ as a
  # rename, not an addition. A move in from outside them is an addition anyway.
  # :(glob,icase) carries its own pathspec magic, since a GIT_*_PATHSPECS setting in
  # the environment would otherwise change what the listing reads: literal or noglob
  # lists nothing, and glob stops a `*` at a slash, so a doc in a subfolder escapes
  # (probed on git 2.55). icase: the review hooks lower-case a path, so
  # docs/.../X.MD is a doc too. glob: `**/` is zero or more folders, whatever the
  # setting. --no-literal-pathspecs turns the one global setting that magic does not
  # override (literal) off for this call. GLOB with NOGLOB together still make git
  # die, and `|| exit 1` blocks on that.
  ADDED=$(git --no-literal-pathspecs diff --cached --no-renames --name-only --diff-filter=A -- ':(glob,icase)docs/superpowers/specs/**/*.md' ':(glob,icase)docs/superpowers/plans/**/*.md') || exit 1
  if [ -n "$ADDED" ]; then
    # One path per line: split on newlines only, so a name with a space stays
    # whole, and not on a glob character.
    IFS='
'
    set -f
    # $ADDED is unquoted on purpose: each line becomes one argument.
    # shellcheck disable=SC2086
    node "$(dirname "$0")/../scripts/spec-review-check.mjs" $ADDED || exit 1
  fi
fi

exec node "$(dirname "$0")/../scripts/review-gate.mjs" check
